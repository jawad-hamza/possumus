desktop/redist/
# PyInstaller writes auto-generated specs next to the script; the maintained one stays tracked.
*.spec
!desktop/zehnms.spec

# Vercel
.vercel/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db


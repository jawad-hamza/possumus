# ZehnMS configuration reference.
#
# Copy to ".env" next to manage.py (it is git-ignored) and uncomment what you need.
# Real environment variables always win over this file. The test suite ignores ".env".
# Every value shown is the built-in default unless the comment says otherwise.
# The Windows desktop build needs none of this: desktop/launcher.py sets it up itself.

# ---------------------------------------------------------------------------
# 1. Core
# ---------------------------------------------------------------------------
# "cloud" = any hosted deployment; "desktop" = the installed single-shop Windows copy
# (plain http on localhost, no online checkout, Django serves uploads).
#DEPLOYMENT_MODE=cloud
# REQUIRED whenever DJANGO_DEBUG is off; the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
#DJANGO_SECRET_KEY=
# Default: true locally, false on Vercel and in desktop mode.
#DJANGO_DEBUG=true
# Comma separated. Default: localhost,127.0.0.1 in debug/desktop, empty otherwise.
# On Vercel the deployment's own *.vercel.app hosts are added automatically.
#DJANGO_ALLOWED_HOSTS=shop.example.com
# Comma separated, with scheme. Needed for a custom domain behind https.
#DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Server fallback only; every user has their own timezone in the app.
#DJANGO_TIME_ZONE=UTC
# Read a different env file instead of ".env" (e.g. ".env.local" from `vercel env pull`).
#ZEHNMS_ENV_FILE=.env.local
# Set by Vercel itself; never set it by hand.
#VERCEL=

# ---------------------------------------------------------------------------
# 2. Where data lives
# ---------------------------------------------------------------------------
# Base folder for the SQLite file, media, logs and backups.
# Default: the project folder; /tmp/zehnms on Vercel; %LOCALAPPDATA%\ZehnMS on desktop.
#ZEHNMS_DATA_DIR=
# Each of these defaults to a sub-folder of ZEHNMS_DATA_DIR.
#SQLITE_PATH=
#DJANGO_MEDIA_ROOT=
#DJANGO_LOG_DIR=
#ZEHNMS_BACKUP_DIR=

# ---------------------------------------------------------------------------
# 3. Database
# ---------------------------------------------------------------------------
# One URL is the easy way. Required on Vercel (Neon / Supabase pooled connection string).
#DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Or piece by piece (DB_ENGINE: sqlite | postgresql | mysql).
#DB_ENGINE=sqlite
#DB_NAME=possumus
#DB_USER=
#DB_PASSWORD=
#DB_HOST=
#DB_PORT=
#DB_SSLMODE=
# Seconds to keep connections open. Default: 0 in debug, on Vercel and for SQLite; 60 otherwise.
#DB_CONN_MAX_AGE=60
#DB_CONN_HEALTH_CHECKS=true
# Must be true behind PgBouncer / pooled connection strings. Default: true on Vercel.
#DB_DISABLE_SERVER_SIDE_CURSORS=false
# How long a second writer waits for SQLite instead of failing.
#SQLITE_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# 4. Cache (API throttling and login lockout count here)
# ---------------------------------------------------------------------------
# locmem | db | redis. Default: locmem; db on Vercel; redis when REDIS_URL is set.
# "db" needs `python manage.py createcachetable` once (the Vercel build does it).
#CACHE_BACKEND=locmem
#CACHE_TABLE=zehnms_cache
# Needs `pip install redis`.
#REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# 5. Security and sessions
# ---------------------------------------------------------------------------
# true only when a reverse proxy (nginx, Vercel) sets X-Forwarded-*. Default: true on Vercel.
# With nginx in front you MUST set this, otherwise the https redirect loops.
#TRUST_PROXY=false
# How many proxies sit in front (used for per-IP API throttling when TRUST_PROXY is on).
#NUM_PROXIES=1
# Fine-grained overrides; both default to TRUST_PROXY.
#DJANGO_USE_X_FORWARDED_HOST=false
#DJANGO_USE_X_FORWARDED_PROTO=false
# These five default to "on" when debug is off and the mode is not desktop.
#DJANGO_SECURE_SSL_REDIRECT=true
#DJANGO_SESSION_COOKIE_SECURE=true
#DJANGO_CSRF_COOKIE_SECURE=true
#DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
#DJANGO_SECURE_HSTS_PRELOAD=true
#DJANGO_SECURE_HSTS_SECONDS=31536000
#DJANGO_CSRF_COOKIE_HTTPONLY=false
#DJANGO_SESSION_COOKIE_SAMESITE=Lax
#DJANGO_CSRF_COOKIE_SAMESITE=Lax
#DJANGO_SECURE_REFERRER_POLICY=same-origin
#DJANGO_X_FRAME_OPTIONS=DENY
# Sign-in lasts 12 hours from the last activity.
#DJANGO_SESSION_COOKIE_AGE=43200
# Failed sign-ins before a lockout, and how long the lockout lasts.
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_LOCKOUT_SECONDS=900
# DRF throttle rates for /api/.
#API_THROTTLE_ANON=30/min
#API_THROTTLE_USER=240/min

# ---------------------------------------------------------------------------
# 6. Uploads, media and backups
# ---------------------------------------------------------------------------
#DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
#DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
#DJANGO_DATA_UPLOAD_MAX_NUMBER_FIELDS=5000
#MAX_LOGO_UPLOAD_BYTES=2097152
# Largest bank receipt (JPG, PNG, WEBP or PDF) that can be attached to a bank payment. 5 MB.
#MAX_RECEIPT_UPLOAD_BYTES=5242880
#MAX_BACKUP_UPLOAD_BYTES=209715200
# Let Django serve /media/ itself. Default: true in debug and desktop mode, false otherwise.
#DJANGO_SERVE_MEDIA=false
# In-app backups. Default: true, false on Vercel (no disk, no pg_dump).
#BACKUPS_AVAILABLE=true
# Restoring an uploaded .sql/.dump runs arbitrary SQL; keep off unless you trust every admin.
#ALLOW_SQL_RESTORE=false
# S3-compatible media storage (AWS S3, Supabase Storage, Cloudflare R2, MinIO).
# Setting the bucket name switches it on; required for logo uploads on Vercel.
#AWS_STORAGE_BUCKET_NAME=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_S3_REGION_NAME=
#AWS_S3_ENDPOINT_URL=
#AWS_S3_CUSTOM_DOMAIN=
#AWS_S3_MEDIA_PREFIX=media
# true = private bucket with signed links; false = public bucket.
#AWS_S3_SIGNED_URLS=true

# ---------------------------------------------------------------------------
# 7. Static files
# ---------------------------------------------------------------------------
# Default: one year when debug is off, 0 in debug.
#WHITENOISE_MAX_AGE=31536000
# Keep false on Windows (collectstatic crashes on it there).
#WHITENOISE_KEEP_ONLY_HASHED_FILES=false

# ---------------------------------------------------------------------------
# 8. Licence and trial (desktop build)
# ---------------------------------------------------------------------------
#TRIAL_DAYS=10
# PEM text of the Ed25519 public key that verifies licence files. When empty the app reads
# LICENSE_PUBLIC_KEY_PATH (default: licensing/public_key.pem, bundled into the installer).
#LICENSE_PUBLIC_KEY=
#LICENSE_PUBLIC_KEY_PATH=

# ---------------------------------------------------------------------------
# 9. Email
# ---------------------------------------------------------------------------
# Default backend: console in debug, SMTP otherwise.
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#DJANGO_EMAIL_HOST=
#DJANGO_EMAIL_PORT=587
#DJANGO_EMAIL_HOST_USER=
#DJANGO_EMAIL_HOST_PASSWORD=
#DJANGO_EMAIL_USE_TLS=true
#DJANGO_EMAIL_USE_SSL=false
#DJANGO_EMAIL_TIMEOUT=10
#DJANGO_DEFAULT_FROM_EMAIL=hello@example.com
#DJANGO_SERVER_EMAIL=server@localhost
#DJANGO_EMAIL_SUBJECT_PREFIX=[ZehnMS]
# Who gets error emails: "Name:email,Name:email".
#DJANGO_ADMINS=

# ---------------------------------------------------------------------------
# 10. Branding
# ---------------------------------------------------------------------------
#PUBLIC_BRAND_NAME=ZehnMS
#PUBLIC_APP_DOMAIN=https://example.com

# ---------------------------------------------------------------------------
# 11. Online subscriptions (Lemon Squeezy) - cloud mode only
# ---------------------------------------------------------------------------
# Default: on when any checkout URL is set and the mode is not desktop.
#LEMON_SQUEEZY_ENABLED=false
#LEMON_SQUEEZY_STARTER_URL=
#LEMON_SQUEEZY_GROWTH_URL=
#LEMON_SQUEEZY_SCALE_URL=
#LEMON_SQUEEZY_WEBHOOK_SECRET=
#LEMON_SQUEEZY_SUCCESS_URL=
#LEMON_SQUEEZY_CANCEL_URL=
#LEMON_SQUEEZY_CUSTOMER_PORTAL_URL=
# JSON object: Lemon Squeezy variant id -> plan code.
#LEMON_SQUEEZY_VARIANT_PLAN_MAP={"123456": "starter", "123457": "growth", "123458": "scale"}

# ---------------------------------------------------------------------------
# 12. Google sign-in (optional)
# ---------------------------------------------------------------------------
# Default: on when both client id and secret are set.
#GOOGLE_SIGN_IN_ENABLED=false
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
# Default: built from the request, <site>/auth/google/callback/.
#GOOGLE_OAUTH_REDIRECT_URI=
#GOOGLE_OAUTH_SCOPE=openid email profile
#GOOGLE_OAUTH_TIMEOUT=10
#GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
#GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# ---------------------------------------------------------------------------
# 13. Logging and error monitoring
# ---------------------------------------------------------------------------
#DJANGO_LOG_LEVEL=INFO
# Default: true; false during tests, on Vercel, and whenever the log folder is not writable.
#DJANGO_FILE_LOGGING=true
#DJANGO_LOG_FILE_MAX_BYTES=5242880
#DJANGO_LOG_FILE_BACKUP_COUNT=5
# Needs `pip install sentry-sdk`.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_RELEASE=
#SENTRY_SEND_DEFAULT_PII=false
#SENTRY_TRACES_SAMPLE_RATE=0.0
#SENTRY_PROFILES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# 14. Review notes (the "Comment" button for testers)
# ---------------------------------------------------------------------------
# 1 = every signed-in user gets a Comment button to pin a note on any part of any
# screen; the owner and admins read them at /review/notes/. Default: off everywhere
# (desktop installs and production). Set it to 1 on the Vercel test deployment and in
# your local development .env. The owner's switch on /review/notes/ overrides it.
#ZEHNMS_REVIEW_NOTES=0

# ---------------------------------------------------------------------------
# 15. Vercel build step only (scripts/vercel_build.py, not read by settings.py)
# ---------------------------------------------------------------------------
# Default: migrate on production builds only. 1 = always, 0 = never.
#ZEHNMS_MIGRATE_ON_BUILD=

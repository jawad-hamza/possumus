# ZehnMS settings for the Docker deployment on a VPS.
#
# deploy/vps-deploy.sh copies this file to /srv/zehnms/.env on the first run and fills in
# every __PLACEHOLDER__. Owner-only (chmod 600). After editing: cd /srv/zehnms/app && docker compose up -d
#
# compose.yaml pins the database host, data folder, proxy and debug settings, so they are not
# repeated here. .env.example in the project root documents every other setting.

DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ALLOWED_HOSTS=__DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__
PUBLIC_APP_DOMAIN=https://__DOMAIN__
DJANGO_TIME_ZONE=Asia/Karachi

# Same value as POSTGRES_PASSWORD in /srv/zehnms/db.env.
DB_PASSWORD=__DB_PASSWORD__

# HSTS for a year. Subdomains and preload stay off until every subdomain of the domain serves
# https; preload is very hard to undo.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Restoring an uploaded SQL dump runs arbitrary SQL as the database user.
ALLOW_SQL_RESTORE=false

# Online subscription checkout. Off: this server runs one business, and the built-in checkout
# links are demo links. See .env.example section 11 to sell plans online.
LEMON_SQUEEZY_ENABLED=false

# Email. Owner sign-up sends a verification email and password reset needs it too.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_SERVER_EMAIL=
# Who receives server error emails: "Name:email,Name:email".
DJANGO_ADMINS=

# gunicorn size. The VPS has 1 vCPU and 4 GB shared with other apps.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Google sign-in (optional): see .env.example section 12.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
